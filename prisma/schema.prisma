/// PAPAN TUGAS ANTAR JABATAN (18 Sep 2026) — penugasan internal dari pimpinan/TU kepada pegawai tertentu
/// atau kepada pemegang jabatan (mis. "Wakil Kepala Sarana Prasarana"). Masuk kotak notifikasi & antrean
/// "Perlu tindakan" penerimanya; penerima menandai dikerjakan/selesai beserta catatan hasil.
model TugasInternal {
  id            String    @id @default(cuid())
  judul         String
  rincian       String?
  pemberiId     String
  pemberiNama   String
  /// Penerima perorangan (User.id). Kosong = ditujukan ke jabatan di `targetJabatan`.
  penerimaId    String?
  penerimaNama  String?
  targetJabatan String[]  @default([])
  prioritas     String    @default("NORMAL") // RENDAH | NORMAL | TINGGI
  tenggat       DateTime?
  status        String    @default("BARU") // BARU | DIKERJAKAN | SELESAI | DIBATALKAN
  catatanHasil  String?
  selesaiPada   DateTime?
  selesaiOleh   String?
