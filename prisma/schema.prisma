generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TAS
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  jabatan   String?
  avatar    String?
  teacher   Teacher?
  student   Student?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String     @unique
  subject        String
  phone          String?
  shortCode      String?    @unique // kode singkat 1-2 huruf untuk tabel jadwal gabungan (A, B, ..., Z, AA, ...)
  // Buku Induk fields
  birthPlace     String?
  birthDate      DateTime?
  gender         String?    // L | P
  religion       String?
  address        String?
  education      String?    // S1 | S2 | D3 | dll.
  position       String?    // Guru Tetap | GTT | PNS | Honorer
  startDate      DateTime?
  teacherStatus  String?    @default("AKTIF")  // AKTIF | PENSIUN | KELUAR
  teacherNotes   String?
  bukuIndukData  Json?
  grades         Grade[]
  homeroomOf     Class[]
  schedules      Schedule[]
  teachingLoad   TeachingAssignment[]
}

model Major {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String
  icon        String?
  logoUrl     String?
  tagline     String?
  longDesc    String?
  skills      String[]  @default([])
  career      String[]  @default([])
  cert        String?
  features    String[]  @default([])
  themeColor  String?
  students    Student[]
  classes     Class[]
  gallery     MajorGallery[]
  subjects    Subject[]
}

model Subject {
  id           String   @id @default(cuid())
  code         Int
  name         String
  category     String   // Kelompok Mapel Umum | Kelompok Mapel Kejuruan | Mapel Diniyah | Muatan Nasional | Muatan Kewilayahan | C3 Kompetensi Keahlian
  grade        Int      // 10 | 11 | 12 — tingkat spesifik, tiap tingkat bisa punya mapel & jam berbeda
  majorId      String?
  major        Major?   @relation(fields: [majorId], references: [id], onDelete: Cascade)
  order        Int      @default(0)
  hoursPerWeek Int      @default(2)
  weekGroup    String   @default("UMUM") // PRODUKTIF | UMUM — dipakai untuk rotasi jadwal 2 minggu kelas X/XI
  maxSharedTeacher Int  @default(1) // maksimal kelas berbeda yang boleh dipegang 1 guru di jam sama utk mapel ini (mis. Penjasorkes = 2)
  createdAt    DateTime @default(now())
  assignments  TeachingAssignment[]
}

model MajorGallery {
  id        String   @id @default(cuid())
  majorId   String
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Class {
  id                  String                @id @default(cuid())
  name                String
  grade               Int
  majorId             String
  major               Major                 @relation(fields: [majorId], references: [id])
  homeroomId          String?
  homeroom            Teacher?              @relation(fields: [homeroomId], references: [id])
  students            Student[]
  schedules           Schedule[]
  studentHistory      StudentClassHistory[]
  teachingAssignments TeachingAssignment[]
}

model Student {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nis            String       @unique
  nisn           String?      @unique
  noInduk        String?      @unique
  classId        String?
  class          Class?       @relation(fields: [classId], references: [id])
  majorId        String
  major          Major        @relation(fields: [majorId], references: [id])
  // Buku Induk fields (basic - indexed)
  birthPlace     String?
  birthDate      DateTime?
  gender         String?      // L | P
  religion       String?
  address        String?
  parentName     String?
  parentPhone    String?
  parentJob      String?
  previousSchool String?
  enrollYear     Int?
  studentStatus  String?      @default("AKTIF")  // AKTIF | LULUS | KELUAR | PINDAH
  exitDate       DateTime?
  studentNotes   String?
  // Buku Induk extended (all sections A-L stored as JSON)
  bukuIndukData  Json?
  grades         Grade[]
  attendance     Attendance[]
  internship     Internship?
  classHistory   StudentClassHistory[]
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  subject   String
  score     Float
  type      String
  semester  String
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
}

model Internship {
  id         String   @id @default(cuid())
  studentId  String   @unique
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company    String
  position   String
  startDate  DateTime
  endDate    DateTime
  supervisor String
  status     String   @default("ONGOING")
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  thumbnail String?
  category  String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admission {
  id             String   @id @default(cuid())
  fullName       String
  birthPlace     String?
  birthDate      DateTime
  gender         String?
  nik            String?
  phone          String
  nisn           String?
  address        String?
  previousSchool String?
  email          String
  guardianName   String?
  chosenMajor    String
  // Dokumen pendukung
  ijazahUrl      String?
  kkUrl          String?
  ktpWaliUrl     String?
  fotoUrl        String?
  dokumenLainUrl String?
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
}

model Gallery {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  category  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  imageUrl  String?
  linkUrl   String?
  linkText  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  subject   String
  day       String   // SENIN | SELASA | RABU | KAMIS | JUMAT | SABTU
  startTime String   // "07:00"
  endTime   String   // "08:30"
  room      String?
  generated    Boolean  @default(false)
  weekType     String   @default("SEMUA") // A | B | SEMUA — SEMUA = tiap minggu (kelas XII & non-rotasi)
  scheduleType String   @default("BLOK") // BLOK = sistem 2 minggu bergantian (dikali 2) | NONBLOK = 1 minggu biasa tanpa kali 2, khusus upload Dapodik
  createdAt    DateTime @default(now())
}

model SchoolPeriod {
  id        String  @id @default(cuid())
  day       String  // SENIN | SELASA | RABU | KAMIS | JUMAT | SABTU
  order     Int     // urutan jam ke-N dalam hari itu
  startTime String  // "07:00"
  endTime   String  // "07:45"
  isBreak   Boolean @default(false)
  label     String? // contoh: "Istirahat"

  @@unique([day, order])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  preferences TeachingPreference[]

  @@unique([classId, subjectId])
}

// Blok preferensi hari/jam untuk Generate Jadwal Otomatis — 1 Penugasan Mengajar boleh
// punya beberapa blok (mis. jam banyak dipecah ke beberapa hari), dicoba duluan sebelum
// penempatan otomatis; total jam blok tidak harus pas jumlah jam mapelnya — sisanya
// akan dilanjutkan otomatis seperti biasa.
model TeachingPreference {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  day                  String             // SENIN..SABTU
  startTime            String             // "07:15" dst — harus cocok SchoolPeriod
  hours                Int                // jumlah jam berturut-turut mulai dari startTime
  weekType             String             @default("SEMUA") // A | B | SEMUA — SEMUA = berlaku di minggu manapun blok ini kebetulan diproses
  createdAt            DateTime           @default(now())
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  targetRole String    @default("ALL") // ALL | STUDENT | TEACHER | ADMIN
  priority   String    @default("NORMAL") // NORMAL | URGENT
  active     Boolean   @default(true)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MasterData {
  id        String   @id @default(cuid())
  category  String   @unique
  label     String
  items     Json
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id             String                @id @default(cuid())
  name           String                @unique  // "2024/2025"
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean               @default(false)
  notes          String?
  createdAt      DateTime              @default(now())
  studentHistory StudentClassHistory[]
}

model Surat {
  id         String   @id @default(cuid())
  tipe       String   // MASUK | KELUAR
  nomor      String
  tanggal    DateTime
  pihak      String   // "dari siapa" (MASUK) atau "kepada siapa" (KELUAR)
  perihal    String
  keterangan String?
  fileUrl    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Arsip {
  id         String   @id @default(cuid())
  judul      String
  kategori   String
  nomor      String?
  tanggal    DateTime
  keterangan String?
  fileUrl    String?
  createdAt  DateTime @default(now())
}

model StudentClassHistory {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  status         String        @default("AKTIF")  // AKTIF | LULUS | KELUAR | PINDAH
  grade          Int?
  majorName      String?
  className      String?
  createdAt      DateTime      @default(now())

  @@unique([studentId, academicYearId])
}
