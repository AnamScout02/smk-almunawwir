  teacher         Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  judul           String
  jenis           String    @default("PELATIHAN") // PELATIHAN | SEMINAR | WORKSHOP | DIKLAT | MGMP | LOMBA | LAINNYA
  penyelenggara   String?
  peran           String? // Peserta | Pemateri | Panitia
  mulai           DateTime  @db.Date
  selesai         DateTime? @db.Date
  jamPelajaran    Int?
  nomorSertifikat String?
  berkas          String? // nama berkas di /uploads (sertifikat, bukan data rahasia)
  catatan         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teacherId])
}

/// MENU CEPAT PILIHAN PENGGUNA (18 September 2026) — daftar href menu yang ditampilkan di kisi
/// "Menu Cepat" dashboard, diatur sendiri tiap akun lewat tombol Atur (pola "Transaksi Favorit"
/// di aplikasi bank). Kosong/ tidak ada baris = memakai urutan bawaan portal.
model MenuFavorit {
